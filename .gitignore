# Source-only export: exclude datasets, partitions and generated artifacts.
/data/
/results/
/result_other_method/
/tmp/
.env
.env.*
.venv/
.pytest_cache/
*.pt
*.pth
*.ckpt
*.log

# Python bytecode and temporary files
__pycache__/
*.py[cod]
*.tmp

# Generated model checkpoint exceeds GitHub's regular-file size limit.
/results/**/final_global_model.pt

# InteractionDispatch overnight-search raw outputs stay local. Compact
# manifest/summary files at the search root remain eligible for versioning.
/results/interaction_dispatch_peak_search*/logs/
/results/interaction_dispatch_peak_search*/runs/
/results/interaction_dispatch_degeneration_regression/*.stdout.log
/results/interaction_dispatch_degeneration_regression/metrics/
